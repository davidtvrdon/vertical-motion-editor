# Copy to .env (scripts/setup.sh does it for you). .env is gitignored: never commit it.

# Pexels: free stock video and photos for b-roll. Get your own key in about a minute:
#   1) sign up at https://www.pexels.com/api/   2) copy "Your API Key"   3) paste it here
PEXELS_API_KEY=

# Optional: HuggingFace token (only needed for speaker labels, WhisperX --diarize)
HF_TOKEN=

# Optional: use an existing Chrome/Chromium instead of the headless Chrome Remotion downloads
# REMOTION_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
